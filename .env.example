# Variables de entorno para el backend
# Copia este archivo como .env o configúralas en tu sistema operativo / servidor

# Base de Datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/restaurant
DB_USERNAME=postgres
DB_PASSWORD=TU_PASSWORD_SEGURO_AQUI

# Servidor
SERVER_PORT=8080

# CORS - Lista de orígenes permitidos (valores separados por coma)
# Desarrollo:
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Producción (ejemplo):
# CORS_ALLOWED_ORIGINS=https://mi-restaurante.com,https://pos.mi-restaurante.com

# JWT - CAMBIA ESTO EN PRODUCCIÓN (mínimo 32 caracteres)
JWT_SECRET=cambia-esta-clave-secreta-de-jwt-en-produccion-min-32-chars
